; Template for secrets.local.ini (gitignored, never commit the real file).
;
; Provides:
;   - REBOOT2_HMAC_SECRET — shared HMAC secret used by the command-loss timer
;     and commit-confirm layers (src/auth_token.h, fixer ADR 0055 §4) to
;     authenticate home-contact and confirm tokens.
;   - REBOOT2_OTA_PASSWORD — the espota auth password (src/main.cpp
;     `enable_ota()`), replacing the old hardcoded "transport" value.
; Both are sourced from SOPS at bench/deploy time — see
; docs/command-loss-timer.md and docs/observability.md for exactly how.
;
; Copy this file to secrets.local.ini and fill in the real values before a
; bench/deploy build. `pio run` succeeds without this file present — with no
; REBOOT2_HMAC_SECRET, the command-loss timer / commit-confirm layer
; (src/main.cpp's "CLT / Commit-Confirm runtime" section) compiles out
; entirely and every relay stays fully manual (published as
; electrical.reboot2.clt.armed = false); REBOOT2_OTA_PASSWORD falls back to
; the prior hardcoded value (with a build-time #warning) so a clean checkout
; still builds.
;
; IMPORTANT: these flags go in [secrets], not [env] — platformio.ini
; interpolates ${secrets.build_flags} into [env]'s own build_flags. Putting
; them directly in an [env] section here would REPLACE (not merge with)
; platformio.ini's own [env] build_flags (CORE_DEBUG_LEVEL etc.), breaking
; the build outright — see the comment in platformio.ini above [secrets].

[secrets]
build_flags =
    -D REBOOT2_HMAC_SECRET='"REPLACE_WITH_SOPS_SOURCED_SECRET"'
    -D REBOOT2_OTA_PASSWORD='"REPLACE_WITH_SOPS_SOURCED_OTA_PASSWORD"'
