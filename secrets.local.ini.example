; Template for secrets.local.ini (gitignored, never commit the real file).
;
; Provides:
;   - REBOOT2_HMAC_SECRET — shared HMAC secret used by the command-loss timer
;     and commit-confirm layers (src/auth_token.h, fixer ADR 0055 §4) to
;     authenticate home-contact and confirm tokens.
;   - REBOOT2_OTA_PASSWORD — the espota auth password (src/main.cpp
;     `enable_ota()`), replacing the old hardcoded "transport" value.
; Both are sourced from SOPS at bench/deploy time — see
; docs/command-loss-timer.md and docs/observability.md for exactly how.
;
; Copy this file to secrets.local.ini and fill in the real values before a
; bench/deploy build. `pio run` succeeds without this file present — the
; HMAC secret is optional until a future job wires src/command_loss_timer.h
; / src/commit_confirm.h into main.cpp, and REBOOT2_OTA_PASSWORD falls back
; to the prior hardcoded value (with a build-time #warning) so a clean
; checkout still builds.

[env]
build_flags =
    -D REBOOT2_HMAC_SECRET='"REPLACE_WITH_SOPS_SOURCED_SECRET"'
    -D REBOOT2_OTA_PASSWORD='"REPLACE_WITH_SOPS_SOURCED_OTA_PASSWORD"'
