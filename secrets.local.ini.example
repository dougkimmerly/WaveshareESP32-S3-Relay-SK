; Template for secrets.local.ini (gitignored, never commit the real file).
;
; Provides the shared HMAC secret used by the command-loss timer and
; commit-confirm layers (src/auth_token.h, fixer ADR 0055 §4) to authenticate
; home-contact and confirm tokens. See docs/command-loss-timer.md for how
; this is sourced from SOPS at bench/deploy time.
;
; Copy this file to secrets.local.ini and fill in the real secret before a
; bench/deploy build that needs the command-loss timer wired live. `pio run`
; succeeds without this file present — it's optional until a future job
; wires src/command_loss_timer.h / src/commit_confirm.h into main.cpp.

[env]
build_flags =
    -D REBOOT2_HMAC_SECRET='"REPLACE_WITH_SOPS_SOURCED_SECRET"'
